---
const steps = [
  { title: 'Share the science', description: 'Send your brief, sketch or manuscript.' },
  { title: 'Shape the story', description: 'Agree the structure and visual direction.' },
  { title: 'Review together', description: 'Refine scientific details and presentation.' },
  { title: 'Prepare the files', description: 'Export for the intended publication or format.' },
];
---
<section id="process" class="sci-process" aria-labelledby="process-title">
  <div class="sci-shell">
    <h2 id="process-title">From your research to the final figure</h2>
    <ol class="sci-process-grid">
      {steps.map((step, index) => <li>
        <div class="sci-step-track"><span>{String(index + 1).padStart(2, '0')}</span></div>
        <h3>{step.title}</h3><p>{step.description}</p>
      </li>)}
    </ol>
  </div>
</section>
