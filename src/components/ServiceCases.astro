---
import UiIcon from './UiIcon.astro';
const services = [
  { title: 'Graphical abstracts', description: 'A clear visual story of your study.', href: '/portfolio/explain/#graphical-abstracts' },
  { title: 'Mechanism diagrams', description: 'Pathways, processes and interactions.', href: '/portfolio/explain/#mechanism-diagrams' },
  { title: 'Scientific illustration', description: 'From molecular to anatomical detail.', href: '/portfolio/figures/' },
  { title: 'Figure design', description: 'Consistent layouts for your research data.', href: '/portfolio/explain/#data-visualization' },
];
---
<section id="services" class="sci-services sci-shell" aria-labelledby="services-title">
  <header class="sci-section-heading">
    <h2 id="services-title">What do you need to illustrate?</h2>
    <p>Commission custom scientific figures tailored to your research and communication goals.</p>
  </header>
  <div class="sci-service-grid">
    {services.map(service => <article class="sci-service">
      <h3>{service.title}</h3>
      <p>{service.description}</p>
      <a class="sci-link" href={service.href} aria-label={`Learn more about ${service.title.toLowerCase()}`}>Learn more <UiIcon /></a>
    </article>)}
  </div>
</section>
