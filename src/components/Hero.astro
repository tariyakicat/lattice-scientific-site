---
import Icon from "./Icon.astro";
---

<section id="home" class="lv-hero" style="--hero-bg: url('/generated/hero-background-wide.webp')">
  <div class="lv-hero-inner">
    <div class="lv-hero-grid">
      <div class="lv-hero-copy" data-reveal>
        <p class="lv-hero-eyebrow"><Icon name="sparkles" size={16} /> Research communication for science-led teams</p>
        <h1 class="lv-hero-title">
          <span>Turning research</span>{" "}
          <span>into engaging</span>{" "}
          <span>experiences.</span>
        </h1>
        <p class="lv-hero-subtitle">From concise summaries to immersive experiences, we help research teams and science-led companies across biotechnology, chemicals, environmental solutions and advanced materials turn complex work into engaging formats that move real audiences.</p>
        <div class="lv-hero-actions">
          <a href="#contact" class="lv-hero-btn lv-hero-btn-primary">Start a project <span aria-hidden="true">→</span></a>
          <a href="#services" class="lv-hero-btn lv-hero-btn-secondary">View our work <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
