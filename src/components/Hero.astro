---
import UiIcon from './UiIcon.astro';
---
<section id="home" class="sci-hero" aria-labelledby="hero-title">
  <img class="sci-hero-background" src="/generated/hero-background-wide.webp" width="2400" height="1100" alt="" fetchpriority="high" />
  <div class="sci-shell sci-hero-inner">
    <div class="sci-hero-copy">
      <p class="sci-eyebrow">Scientific illustration</p>
      <h1 id="hero-title">Your research,<br />clearly illustrated.</h1>
      <p class="sci-hero-description">Graphical abstracts, mechanism diagrams and scientific figures for research communication.</p>
      <div class="sci-actions">
        <a class="sci-button" href="#contact">Discuss your project</a>
        <a class="sci-link" href="#selected-work">Explore our work <UiIcon /></a>
      </div>
    </div>
  </div>
</section>
