---
import { applications } from "@/lib/applications";
import Icon from "./Icon.astro";
import { getAllResources, resourceSlug } from "@/lib/resources";
interface Props { embedded?: boolean; }
const { embedded = false } = Astro.props;
const applicationContexts = Object.fromEntries(applications.map((application) => [application.id, { title: application.shortTitle, projectType: application.projectType, channel: application.channel }]));
const resourceTitles = Object.fromEntries((await getAllResources()).map((resource) => [resourceSlug(resource), resource.data.title]));
---

<section id={embedded ? undefined : "contact"} class:list={["contact-section relative overflow-hidden bg-slate-50 py-20 md:py-24", { "contact-embedded": embedded }]}>
  <div class="contact-shell mx-auto max-w-7xl px-5 md:px-8">
    <div class="contact-card" data-contact-card data-resource-titles={JSON.stringify(resourceTitles)} data-application-contexts={JSON.stringify(applicationContexts)}>
      <div class="contact-info">
        <img class="contact-info-art" src="/contact-ink.png" alt="" aria-hidden="true" />
        <div class="contact-info-content">
          <p class="contact-label">Contact</p>
          <h2><span>What are you</span><span>working on?</span></h2>
          <a class="contact-email" href="mailto:contact@latticevisual.com"><Icon name="mail" /><span>contact@latticevisual.com</span></a>
          <p class="contact-intro">An early idea, a research story or a brief ready to go. Tell us what you have in mind.</p>
          <p class="contact-response">We typically reply within 1 business day.</p>
          <div class="contact-trust" aria-label="Contact assurances">{["Fast response", "Confidential", "No obligation"].map((item) => <span><Icon name="check" size={18} />{item}</span>)}</div>
        </div>
      </div>
      <div class="contact-form-area">
        <form class="contact-form" novalidate data-contact-form>
          <p class="contact-resource-context" data-resource-context hidden></p>
          <label class="contact-honeypot" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" /></label>
          <div class="contact-form-grid">
            <label class="contact-field" for="contact-name"><span>Your name <em>*</em></span><input id="contact-name" name="name" type="text" placeholder="Your name" autocomplete="name" required aria-describedby="contact-name-error" /><small id="contact-name-error" class="contact-error" data-error="name"></small></label>
            <label class="contact-field" for="contact-email"><span>Email address <em>*</em></span><input id="contact-email" name="email" type="email" placeholder="Email address" autocomplete="email" required aria-describedby="contact-email-error" /><small id="contact-email-error" class="contact-error" data-error="email"></small></label>
            <label class="contact-field" for="contact-project-type"><span>Project type</span><span class="contact-select-wrap"><select id="contact-project-type" name="projectType"><option value="">Select project type</option>{(embedded ? ["Graphical abstract", "Mechanism diagram", "Scientific illustration", "Figure design", "Data visualization", "Presentation design", "Research poster", "Other"] : ["Graphical abstract", "Mechanism diagram", "Scientific illustration", "Figure design", "Health communication", "Education & learning materials", "Skin & beauty illustration", "Product & technology communication", "Infographic", "Data visualization", "Presentation design", "Research poster", "Website & interactive experience", "Grant & impact showcase", "Other"]).map(type => <option>{type}</option>)}</select><span aria-hidden="true">⌄</span></span></label>
            <label class="contact-field" for="contact-target"><span>Target audience / deadline</span><input id="contact-target" name="target" type="text" placeholder="Target audience / deadline" /></label>
            <label class="contact-field contact-field-full" for="contact-channel"><span>Where will it be used?</span><input id="contact-channel" name="channel" type="text" maxlength="240" placeholder="For example: course, website, product page, social media or paper" /></label>
            <label class="contact-field contact-field-full" for="contact-message"><span>Tell us about your project <em>*</em></span><textarea id="contact-message" name="message" placeholder="What would you like to explain, who is it for, and what do you need us to create?" rows="5" required aria-describedby="contact-message-error"></textarea><small id="contact-message-error" class="contact-error" data-error="message"></small></label>
          </div>
          <div class="contact-submit-row">
            <div>
              <div class="contact-dropzone" role="button" tabindex="0" aria-label="Upload brief or files" data-dropzone><Icon name="upload" /><span><strong>Upload brief or files (optional)</strong><small>Drag and drop or <b>click to browse</b></small></span></div>
              <input class="contact-file-input" type="file" multiple aria-label="Choose project files" data-file-input />
              <ul class="contact-file-list" aria-label="Selected files" data-file-list hidden></ul>
            </div>
            <button class="contact-send" type="submit" data-contact-send>Send message <span aria-hidden="true">→</span></button>
          </div>
          <p class="contact-form-error" role="alert" aria-live="polite" data-form-error hidden></p>
        </form>
        <div class="contact-success" role="status" data-contact-success hidden><span class="contact-success-icon"><Icon name="check" /></span><h3>Thanks — your enquiry has been sent.</h3><p>We’ll review your project details and reply by email.</p><button type="button" data-contact-reset>Send another message</button></div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-contact-card]").forEach((card) => {
    const form = card.querySelector<HTMLFormElement>("[data-contact-form]");
    const success = card.querySelector<HTMLElement>("[data-contact-success]");
    const input = card.querySelector<HTMLInputElement>("[data-file-input]");
    const dropzone = card.querySelector<HTMLElement>("[data-dropzone]");
    const fileList = card.querySelector<HTMLUListElement>("[data-file-list]");
    const sendButton = card.querySelector<HTMLButtonElement>("[data-contact-send]");
    const formError = card.querySelector<HTMLElement>("[data-form-error]");
    const resourceSlug = new URL(window.location.href).searchParams.get("resource");
    const resourceTitles: Record<string, string> = JSON.parse(card.dataset.resourceTitles ?? "{}");
    const resourceTitle = resourceSlug && Object.hasOwn(resourceTitles, resourceSlug) ? resourceTitles[resourceSlug] : undefined;
    const applicationId = new URL(window.location.href).searchParams.get("application");
    const applicationContexts: Record<string, { title: string; projectType: string; channel: string }> = JSON.parse(card.dataset.applicationContexts ?? "{}");
    const application = applicationId && Object.hasOwn(applicationContexts, applicationId) ? applicationContexts[applicationId] : undefined;
    const applyResourceContext = () => {
      const title = application?.title ?? resourceTitle;
      if (!title) return;
      const context = card.querySelector<HTMLElement>("[data-resource-context]");
      const message = form?.querySelector<HTMLTextAreaElement>("[name='message']");
      if (context) { context.textContent = `Enquiring about: ${title}`; context.hidden = false; }
      if (message && !message.value) message.value = `I'd like to discuss a custom visual project related to ${title}.\n\nProject details: `;
      const projectType = form?.querySelector<HTMLSelectElement>("[name='projectType']");
      const channel = form?.querySelector<HTMLInputElement>("[name='channel']");
      if (application && projectType && !projectType.value) { if (![...projectType.options].some(option => option.value === application.projectType)) projectType.add(new Option(application.projectType, application.projectType)); projectType.value = application.projectType; }
      if (application && channel && !channel.value) channel.value = application.channel;
    };
    applyResourceContext();
    let selectedFiles: File[] = [];
    const showFiles = (files: FileList | File[] | null) => {
      selectedFiles = [...(files ?? [])];
      if (!fileList) return;
      fileList.innerHTML = "";
      selectedFiles.forEach((file) => { const item = document.createElement("li"); item.textContent = file.name; fileList.append(item); });
      fileList.hidden = selectedFiles.length === 0;
    };
    const openPicker = () => input?.click();
    dropzone?.addEventListener("click", openPicker);
    dropzone?.addEventListener("keydown", (event) => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); openPicker(); } });
    input?.addEventListener("change", () => showFiles(input.files));
    ["dragenter", "dragover"].forEach((type) => dropzone?.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.add("is-dragging"); }));
    ["dragleave", "drop"].forEach((type) => dropzone?.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.remove("is-dragging"); }));
    dropzone?.addEventListener("drop", (event) => showFiles((event as DragEvent).dataTransfer?.files ?? null));
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const errors: Record<string, string> = {};
      const name = String(values.get("name") ?? "").trim();
      const email = String(values.get("email") ?? "").trim();
      const message = String(values.get("message") ?? "").trim();
      if (!name) errors.name = "Please enter your name.";
      if (!email) errors.email = "Please enter your email address."; else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.email = "Please enter a valid email address.";
      if (!message) errors.message = "Please tell us a little about your project.";
      ["name", "email", "message"].forEach((field) => { const node = form.querySelector<HTMLElement>(`[data-error="${field}"]`); const control = form.elements.namedItem(field) as HTMLElement | null; if (node) node.textContent = errors[field] ?? ""; control?.setAttribute("aria-invalid", String(Boolean(errors[field]))); });
      if (Object.keys(errors).length) { form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }
      if (formError) formError.hidden = true;
      selectedFiles.forEach((file) => values.append("files", file, file.name));
      if (sendButton) { sendButton.disabled = true; sendButton.textContent = "Sending…"; }
      try {
        const response = await fetch("/api/contact", { method: "POST", body: values });
        const payload = await response.json().catch(() => ({ error: "We could not send your message. Please email contact@latticevisual.com directly." }));
        if (!response.ok) throw new Error(payload.error || "We could not send your message.");
        form.hidden = true;
        if (success) success.hidden = false;
      } catch (error) {
        if (formError) {
          formError.textContent = error instanceof Error ? error.message : "We could not send your message. Please try again.";
          formError.hidden = false;
        }
      } finally {
        if (sendButton) { sendButton.disabled = false; sendButton.textContent = 'Send message'; }
      }
    });
    card.querySelector("[data-contact-reset]")?.addEventListener("click", () => { form?.reset(); applyResourceContext(); if (form) form.hidden = false; if (success) success.hidden = true; if (formError) formError.hidden = true; showFiles(null); });
  });
</script>
