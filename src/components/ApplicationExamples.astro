---
import ApplicationPreview from "./ApplicationPreview.astro";
import { applications } from "@/lib/applications";
---

<section id="applications" class="application-examples" aria-labelledby="application-examples-title">
  <header class="application-section-heading" data-reveal><div><p class="section-label">Ideas in use</p><h2 id="application-examples-title">Made to explain.<br />Ready to connect.</h2></div><p>From a health explainer to a classroom lesson or a product story. Explore three studio concepts built around a specific audience and use.</p></header>
  <div class="application-example-grid">
    {applications.map((application) => <article data-reveal>
      <a class="application-example-link" href={`/applications/#${application.id}`}>
        <ApplicationPreview id={application.id} />
        <p class="application-category">{application.category} · Studio concept</p>
        <h3>{application.shortTitle} <span aria-hidden="true">↗</span></h3>
        <p>{application.summary}</p>
      </a>
    </article>)}
  </div>
</section>
