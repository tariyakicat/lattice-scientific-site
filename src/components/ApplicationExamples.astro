---
import ApplicationPreview from "./ApplicationPreview.astro";
import { applications } from "@/lib/applications";
---

<section id="applications" class="application-examples" aria-labelledby="application-examples-title">
  <header class="application-section-heading" data-reveal><div><p class="section-label">Illustration applications</p><h2 id="application-examples-title">Made to inform.<br />Designed to connect.</h2></div><p>A poster, a lesson, a technical story. These studio concepts explore how illustration works in the real world.</p></header>
  <div class="application-example-grid">
    {applications.map((application) => <article data-reveal>
      <a class="application-example-link" href={`/applications/#${application.id}`}>
        <ApplicationPreview id={application.id} compact />
        <p class="application-category">{application.category} · Studio concept</p>
        <h3>{application.shortTitle}</h3>
        <p class="application-card-summary">{application.summary}</p>
        <span class="application-view-example">View example <span aria-hidden="true">→</span></span>
      </a>
    </article>)}
  </div>
</section>
