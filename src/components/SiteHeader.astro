---
import SiteBrand from './SiteBrand.astro';
import UiIcon from './UiIcon.astro';
interface Props { scientificHome?: boolean; }
const { scientificHome = false } = Astro.props;
const currentPath = Astro.url.pathname;
const links = scientificHome ? [
  { href: '/portfolio/', label: 'Work' }, { href: '/#services', label: 'Services' }, { href: '/#process', label: 'Process' },
] : [
  { href: '/portfolio/', label: 'Work' }, { href: '/#services', label: 'Services' }, { href: '/blog/', label: 'Blog' },
  { href: '/resources/', label: 'Resources' }, { href: '/applications/', label: 'Applications' },
];
---
<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <SiteBrand />
    <div class="site-nav-links">{links.map(link => <a href={link.href} aria-current={!link.href.includes('#') && currentPath.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
    <a class="site-nav-cta" href="/#contact">Start a project</a>
    <details class="site-nav-mobile">
      <summary aria-label="Open navigation menu"><UiIcon name="menu" /></summary>
      <div>{links.map(link => <a href={link.href}>{link.label}</a>)}<a href="/#contact">Start a project</a></div>
    </details>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.site-nav-mobile');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
  document.addEventListener('click', event => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
</script>
