---
import { Image } from "astro:assets";
import health from "@/assets/applications/health-education-poster.png";
import education from "@/assets/applications/plant-biology-lesson.png";
import technology from "@/assets/applications/technical-project-report.png";
import type { ApplicationId } from "@/lib/applications";

interface Props { id: ApplicationId; compact?: boolean; }
const { id, compact = false } = Astro.props;
const previews = {
  "health-education": { image: health, alt: "Concept health education poster with a labelled skin cutaway and magnified views of the epidermis, dermis and subcutaneous tissue" },
  "plant-biology-lesson": { image: education, alt: "Concept plant biology lesson showing four illustrated stages from seed to seedling, stage labels and a discussion prompt" },
  "environmental-technology": { image: technology, alt: "Concept technical report spread with a filtration-system cutaway, a three-step process diagram and a visual legend" },
};
const preview = previews[id];
const sizes = compact ? "(min-width: 761px) 31vw, 95vw" : "(min-width: 1040px) 992px, 95vw";
---
<div class="application-preview">
  <Image src={preview.image} alt={preview.alt} widths={[480, 800, 1200, 1440]} sizes={sizes} format="webp" loading="lazy" />
</div>
