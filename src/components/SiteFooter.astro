---
import SiteBrand from './SiteBrand.astro';
interface Props { scientificHome?: boolean; }
const { scientificHome = false } = Astro.props;
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <SiteBrand />
    <nav aria-label="Footer navigation"><a href="/portfolio/">Work</a><a href="/#services">Services</a><a href="/#contact">Contact</a></nav>
  </div>
  {!scientificHome && <div class="site-footer-secondary"><nav aria-label="More from Lattice Visual"><a href="/applications/">Applications</a><a href="/blog/">Blog</a><a href="/resources/">Resources</a></nav><a href="mailto:contact@latticevisual.com">contact@latticevisual.com</a></div>}
</footer>
