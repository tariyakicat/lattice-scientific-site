---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCases from '@/components/ServiceCases.astro';
import SelectedWork from '@/components/SelectedWork.astro';
import Process from '@/components/Process.astro';
import ProjectEnquiry from '@/components/ProjectEnquiry.astro';
import '@/styles/scientific-home.css';
const description = 'Custom graphical abstracts, mechanism diagrams and scientific illustrations for research communication. Explore our work and discuss your next figure.';
const organizationJsonLd = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Lattice Visual',
  url: new URL('/', Astro.site).href, email: 'contact@latticevisual.com', description,
};
---
<BaseLayout title="Lattice Visual — Scientific Illustration" {description} jsonLd={organizationJsonLd} scientificHome>
  <Hero /><ServiceCases /><SelectedWork /><Process /><ProjectEnquiry />
</BaseLayout>
