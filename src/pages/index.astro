---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import Hero from "@/components/Hero.astro";
import Process from "@/components/Process.astro";
import ServiceCases from "@/components/ServiceCases.astro";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Lattice Visual",
  url: new URL("/", Astro.site).href,
  email: "contact@latticevisual.com",
  description: "Research communication for research teams and science-led companies across biotechnology, chemicals, environmental solutions and advanced materials.",
};
---

<BaseLayout
  title="Lattice Visual — Research Communication Studio"
  description="Research communication for science-led teams: scientific visuals, data visualization, slides, posters, interactive research microsites and impact showcases."
  jsonLd={organizationJsonLd}
>
  <Hero />
  <ServiceCases />
  <Process />
  <ContactForm />
</BaseLayout>
